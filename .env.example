# Discord bot token (required)
# Create a bot at https://discord.com/developers/applications and copy the token.
DISCORD_TOKEN=your-bot-token-here

# Application ID of the bot (required)
# Found on the Discord Developer Portal, under General Information.
DISCORD_CLIENT_ID=your-application-id-here

# Optional: register commands to one server only (instant updates).
# Leave unset to register globally (may take up to an hour to appear).
GUILD_ID=

# Optional: global role ID allowed to create/send announcements.
# Can be overridden per server with the /setup command.
AUTHORIZED_ROLE_ID=

# Optional: where the JSON database files are stored.
DATA_DIR=./data

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Optional: override fallback emojis with custom application emojis.
# Copy the emoji exactly as it appears when typing :name: with the app active,
# e.g. EMOJI_ANNOUNCEMENT=<:megaphone:1234567890123456789>
EMOJI_ANNOUNCEMENT=
EMOJI_CREATE=
EMOJI_SEND=
EMOJI_CANCEL=
EMOJI_SUCCESS=
EMOJI_ERROR=
EMOJI_WARNING=
EMOJI_INFO=
EMOJI_DENIED=
EMOJI_STATISTICS=
EMOJI_HISTORY=
EMOJI_AUDIT=
EMOJI_SETTINGS=
EMOJI_SERVER=
EMOJI_DELIVERY=
EMOJI_FIRST_PAGE=
EMOJI_PREVIOUS=
EMOJI_NEXT=
EMOJI_LAST_PAGE=
EMOJI_SPARKLES=
EMOJI_CLOCK=
